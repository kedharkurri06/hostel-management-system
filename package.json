{
  "name": "hostel-hub-management",
  "version": "1.0.0",
  "description": "HostelHub - Campus Residence & Digital Management Portal (MERN Stack)",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
    "import:students": "npm run import:students --prefix server",
    "build": "npm run build --prefix client",
    "test": "npm test --prefix server",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
